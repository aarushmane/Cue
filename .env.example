# Copy to .env.local and fill in. Never commit real values.
# Leave the Supabase vars empty to run on the built-in seeded in-memory store.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only
# AI provider: AI_PROVIDER=anthropic|gemini forces one; unset = Anthropic if its key is set, else Gemini.
AI_PROVIDER=
GEMINI_API_KEY=                   # server only — free tier from Google AI Studio
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_AGENT_MODEL=               # optional stronger model for the onboarding deepagent
ANTHROPIC_API_KEY=                # server only — vision (shelf recognition + landmark matching)
CLAUDE_MODEL=claude-opus-5-5
ELEVENLABS_API_KEY=               # server only, optional — falls back to browser speechSynthesis
ELEVENLABS_VOICE_ID=

# CoStar "Inside and Out" track: run /costar-keys in the track Discord. Server only.
MATTERPORT_API_KEY=               # "API key" (basic-auth user); production api.matterport.com only
MATTERPORT_API_TOKEN=             # "API token" (basic-auth password)
VEXCEL_API_KEY=                   # Houston + Los Angeles coverage only
MATTERPORT_INDEX_CSV=             # optional; default data/models_index.csv (download from the quickstart page)
COSTAR_KIT_DIR=                   # optional; folder where you unzipped the CoStar kit (zip password from /costar-keys)

# LangChain deepagents (onboarding agent). LangSmith tracing is optional but shows agent steps to judges.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=storeguide      # optional; traces go to the "default" project without it
# Explicit callback draining covers invoke and stream, including failures.
# Optional: LANGCHAIN_CALLBACKS_BACKGROUND=false makes each step wait for callbacks.

# Staff auth when Supabase is NOT configured (local/demo only): send `Authorization: Bearer $STAFF_DEMO_TOKEN`.
STAFF_DEMO_TOKEN=

# Staff onboarding screen (/business/onboard) in memory mode: when set, a demo run must enter this passcode.
# Required in production memory mode (runs are refused without it); optional in `next dev`.
ONBOARD_PASSCODE=

# POST /api/observations (shopper, unauthenticated): submissions per minute per client address. Default 20.
OBSERVATION_RATE_LIMIT=

# Private token required by POST /api/db/properties (property → Matterport scan mapping).
PROPERTY_WRITE_TOKEN=

# Matterport Showcase SDK key (browser). Enables drawing routes inside the 3D tour; add your site's domain to the key's
# allowed domains at matterport.com/developers. Without it, routes show on a 2D map next to the directions.
NEXT_PUBLIC_MATTERPORT_SDK_KEY=
# POST /api/wayfinding/agent: requests per minute per client address. Default 20.
WAYFINDING_AGENT_RATE_LIMIT=
# Gemini models to switch to when one runs out of free-tier quota (comma-separated; empty disables).
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite

# Optional Python backend overrides; otherwise it reuses NEXT_PUBLIC_SUPABASE_* above.
# Use only a public anon/publishable key. The backend does not use the service role.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
