# Copy to .env.local and fill in. Never commit real values.
# Leave the Supabase vars empty to run on the built-in seeded in-memory store.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only
# AI provider: AI_PROVIDER=anthropic|gemini forces one; unset = Anthropic if its key is set, else Gemini.
AI_PROVIDER=
GEMINI_API_KEY=                   # server only — free tier from Google AI Studio
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_AGENT_MODEL=               # optional stronger model for the onboarding deepagent
ANTHROPIC_API_KEY=                # server only — vision (shelf recognition + landmark matching)
CLAUDE_MODEL=claude-opus-5-5
ELEVENLABS_API_KEY=               # server only, optional — falls back to browser speechSynthesis
ELEVENLABS_VOICE_ID=

# CoStar "Inside and Out" track: keys come from the CoStar team at the event. Names are placeholders; rename them to match their SDK.
COSTAR_API_KEY=
MATTERPORT_API_KEY=
VEXCEL_API_KEY=

# LangChain deepagents (onboarding agent). LangSmith tracing is optional but shows agent steps to judges.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false

# Staff auth when Supabase is NOT configured (local/demo only): send `Authorization: Bearer $STAFF_DEMO_TOKEN`.
STAFF_DEMO_TOKEN=
