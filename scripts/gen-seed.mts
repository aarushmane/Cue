// Regenerates supabase/seed.sql from lib/seed/demo-store.ts.  Run: npm run seed:sql
// (Node ≥ 22.18 runs TypeScript directly via type stripping.)
import { writeFileSync } from "node:fs";
import {
  DEMO_EDGES, DEMO_LANDMARKS, DEMO_LOCATIONS, DEMO_MAP, DEMO_NODES, DEMO_PRODUCTS, DEMO_SHELVES, DEMO_STORE,
} from "../lib/seed/demo-store.ts";

const q = (v: unknown): string => {
  if (v === null || v === undefined) return "null";
  if (typeof v === "number") return String(v);
  if (Array.isArray(v)) return `array[${v.map(q).join(", ")}]::text[]`;
  return `'${String(v).replaceAll("'", "''")}'`;
};
const row = (vals: unknown[]) => `  (${vals.map(q).join(", ")})`;

const s = DEMO_STORE;
const out: string[] = [
  "-- GENERATED by scripts/gen-seed.mts from lib/seed/demo-store.ts. Do not edit by hand.",
  "begin;",
  `insert into stores (id, name, address, latitude, longitude, width_m, height_m, floor_plan_url) values`,
  row([s.id, s.name, s.address, s.latitude, s.longitude, s.widthM, s.heightM, s.floorPlanUrl]) + ";",
  `insert into store_maps (id, store_id, version, status, published_at) values`,
  row([DEMO_MAP.id, DEMO_MAP.storeId, DEMO_MAP.version, DEMO_MAP.status]).replace(/\)$/, ", now())") + ";",
  `insert into nodes (id, map_id, x, y, kind, label, facing_deg) values`,
  DEMO_NODES.map((n) => row([n.id, DEMO_MAP.id, n.x, n.y, n.kind, n.label, n.facingDeg ?? null])).join(",\n") + ";",
  `insert into edges (id, map_id, from_node, to_node, weight) values`,
  DEMO_EDGES.map((e) => row([e.id, DEMO_MAP.id, e.from, e.to, e.weight])).join(",\n") + ";",
  `insert into shelves (id, map_id, aisle, section, anchor_node, x, y, w, h) values`,
  DEMO_SHELVES.map((sh) => row([sh.id, DEMO_MAP.id, sh.aisle, sh.section, sh.anchorNodeId, sh.x, sh.y, sh.w, sh.h])).join(",\n") + ";",
  `insert into landmarks (id, node_id, image_url, description) values`,
  DEMO_LANDMARKS.map((l) => row([l.id, l.nodeId, l.imageUrl, l.description])).join(",\n") + ";",
  `insert into products (id, store_id, name, brand, variant, size, aliases) values`,
  DEMO_PRODUCTS.map((p) => row([p.id, p.storeId, p.name, p.brand, p.variant, p.size, p.aliases])).join(",\n") + ";",
  `insert into product_locations (product_id, shelf_id, level, verified_at) values`,
  DEMO_LOCATIONS.map((l) => row([l.productId, l.shelfId, l.level, l.verifiedAt])).join(",\n") + ";",
  `insert into audit_events (store_id, actor_label, action, entity, new_json) values`,
  row([s.id, "seed", "store.seed", "store"]).replace(/\)$/, `, '{"products": ${DEMO_PRODUCTS.length}}'::jsonb)`) + ";",
  "commit;",
  "",
];

writeFileSync(new URL("../supabase/seed.sql", import.meta.url), out.join("\n"));
console.log(`seed.sql written: ${DEMO_NODES.length} nodes, ${DEMO_EDGES.length} edges, ${DEMO_SHELVES.length} shelves, ${DEMO_PRODUCTS.length} products`);
