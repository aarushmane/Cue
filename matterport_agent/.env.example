# Copy to .env and fill in. Never commit .env.
# provider:model string passed to create_deep_agent.
MATTERPORT_AGENT_MODEL=anthropic:claude-opus-5-5
# Needed when MATTERPORT_AGENT_MODEL uses the anthropic provider.
ANTHROPIC_API_KEY=
# Arrow height above the floor, in meters (demo only).
MATTERPORT_ARROW_VERTICAL_OFFSET_M=0.05
# Path to your real sweep export (relative to matterport_agent/). Optional; --data overrides it.
MATTERPORT_SWEEPS_FILE=data/store-sweeps.json
